// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// Models 

// Product Model
model Product {
  id        Int @id @default(autoincrement())
  name      String
  SKU       String @unique
  desc      String?
  images    String[]
  category  String?
  listings  Listing[]
  orders    Order[]
}

// Store Model — one row per connected shop (e.g. two separate Etsy stores)
model Store {
  id        Int       @id @default(autoincrement())
  platform  String    // "etsy", "ebay", "amazon"
  shopId    String    // the shop's id on that platform
  name      String    // human label, e.g. "Dad's Ornaments"
  listings  Listing[]
  orders    Order[]
  createdAt DateTime  @default(now())

  @@unique([platform, shopId])
}

//Listing Model
model Listing {
  id         Int     @id @default(autoincrement())
  platform   String  // "ebay", "etsy", "amazon"
  platformId String  // the listing ID on that platform
  url        String?
  price      Float
  quantity   Int     // stock on this platform
  status     String  // "active", "sold", "inactive"
  productId  Int
  product    Product @relation(fields: [productId], references: [id])
  storeId    Int?
  store      Store?  @relation(fields: [storeId], references: [id])
  @@unique([platform, platformId, storeId])
}

// Order Model
model Order {
  id        Int      @id @default(autoincrement())
  platform  String   // "ebay", "etsy", "amazon"
  orderId   String   @unique // platform's order ID
  quantity  Int
  salePrice Float
  date      DateTime @default(now())
  status    String   // "pending", "shipped", "delivered"
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  storeId   Int?
  store     Store?   @relation(fields: [storeId], references: [id])
}
// PlatformToken Model
model PlatformToken {
  id Int @id @default(autoincrement())
  platform String
  shopId String
  accessToken String
  refreshToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, shopId])
}